# Root .gitignore for monorepo

# Dependencies
node_modules/
**/node_modules/

# Environment variables & secrets (CRITICAL: never commit credentials)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key

# Data files & spreadsheets (DO NOT COMMIT REAL DATA)
*.xlsx
*.xls
*.csv
Suma_datacenter_master.xlsx
hackaton-backend/prisma/mock/data/

# Internal agent instructions (local only); STACK.md is shareable documentation.
agents/*
!agents/STACK.md

# Build artifacts & caches
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
.turbo/
.cache/

# Coverage & testing
coverage/
**/coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml.bak
*.tsbuildinfo

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
