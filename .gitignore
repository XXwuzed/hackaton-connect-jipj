# Root .gitignore for monorepo

# Dependencies
node_modules/
*/node_modules/

# Environment variables and secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key

# Data files & spreadsheets (DO NOT COMMIT REAL DATA)
*.xlsx
*.xls
*.csv
Suma_datacenter_master.xlsx

# Internal agent instructions (local only)
agents/

# Build artifacts
dist/
*/dist/
build/
*/build/
.next/
*/.next/
out/
*/out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
