{
  "name": "@club/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "mock:customers": "node --env-file=.env --import tsx prisma/mock/load-customers.ts",
    "mock:redeemables": "node --env-file=.env --import tsx prisma/mock/load-redeemables.ts",
    "mock:prizes": "node --env-file=.env --import tsx prisma/mock/load-prizes.ts",
    "mock:sales": "node --env-file=.env --import tsx prisma/mock/load-sales.ts",
    "seed:all": "tsx prisma/seed-all.ts",
    "seed:all:local": "node --env-file=.env --import tsx prisma/seed-all.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@club/contracts": "workspace:*",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.0",
    "cookie-parser": "^1.4.0",
    "cors": "^2.8.0",
    "csv-parse": "5.6.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "jose": "^5.0.0",
    "pino": "^9.0.0",
    "resend": "^4.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
