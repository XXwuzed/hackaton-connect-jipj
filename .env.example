# Copiar a .env solo en el equipo local. Usa secretos propios; no subir .env.
POSTGRES_USER=club
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_DB=club_dev

# Resumen de la API. Copiar los valores apropiados a hackaton-backend/.env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://club:replace-with-local-secret@localhost:5432/club_dev
JWT_ACCESS_SECRET=replace-with-random-local-secret
JWT_REFRESH_SECRET=replace-with-another-random-local-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CUSTOMER_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-with-private-bucket-name
AWS_ACCESS_KEY_ID=replace-with-local-credential
AWS_SECRET_ACCESS_KEY=replace-with-local-credential
AWS_SESSION_TOKEN=replace-with-temporary-session-token
RESEND_API_KEY=replace-with-local-key
MAIL_FROM=replace-with-verified-sender@example.com
RECAPTCHA_SECRET=replace-with-local-secret
RECAPTCHA_BYPASS=true

# Variable pública del formulario. Copiar a hackaton-form-frontend/.env.
VITE_RECAPTCHA_SITE_KEY=replace-with-public-site-key
