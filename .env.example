# ==============================================================================
# Variables de entorno - Club Enlace (Farmaenlace)
# Copia este archivo a .env y asigna valores reales. NUNCA subas .env al repositorio.
# ==============================================================================

# Entorno general
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
# En local suele usarse 'postgres' como usuario y contraseña por defecto en Docker.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=farmaenlace_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmaenlace_dev?schema=public

# Autenticación y Seguridad
JWT_SECRET=tu_secreto_jwt_super_seguro_minimo_32_caracteres
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# AWS S3 (Para fotos de catálogo y productos canjeables)
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=club-enlace-assets-201930053567

# Proveedor de correo (Bienvenida y baja)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Protección contra robots
# RECAPTCHA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
