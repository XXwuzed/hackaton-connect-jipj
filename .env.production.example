# Ejemplo para /opt/hackaton/.env en EC2. Nunca guardar valores reales en Git.
POSTGRES_USER=club_admin
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=farmaenlace_prod
# Codificar caracteres especiales del password en la URL (por ejemplo @ como %40).
DATABASE_URL=postgresql://club_admin:replace-with-url-encoded-password@postgres:5432/farmaenlace_prod?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CORS_ORIGINS=https://d39zayal0ay0sg.cloudfront.net,https://d31wug4nlmf7vo.cloudfront.net
CUSTOMER_WEB_URL=https://d39zayal0ay0sg.cloudfront.net
ADMIN_WEB_URL=https://d31wug4nlmf7vo.cloudfront.net/admin
CONSENT_VERSION=replace-with-approved-consent-version
AWS_REGION=us-east-1
AWS_S3_BUCKET=club-enlace-assets-201930053567
RESEND_API_KEY=replace-with-resend-key
MAIL_FROM=replace-with-verified-sender@example.com
RECAPTCHA_SECRET=replace-with-recaptcha-secret
VITE_RECAPTCHA_SITE_KEY=replace-with-public-recaptcha-site-key
# No poner AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY ni AWS_SESSION_TOKEN en EC2:
# el SDK usa el rol IAM adjunto a la instancia.
